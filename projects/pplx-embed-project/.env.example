# Model cache and download behavior. Keep auto-download disabled for local dev.
MODEL_CACHE_DIR=./model
MODEL_AUTO_DOWNLOAD=false

# Pin a reviewed model revision for reproducible/secure deployments.
MODEL_REVISION=

# API configuration.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
API_URL=http://localhost:8000
